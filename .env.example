# Server Configuration
PORT=5000
NODE_ENV=development

# Admin API Secret Token (Must be configured in production)
ADMIN_TOKEN=replace_with_a_long_random_secret_token

# Database Path
DB_PATH=./db/portfolio.sqlite

# CORS Allowed Origin (Must be set to your portfolio domain in production, e.g. https://yourdomain.com)
CORS_ORIGIN=https://yourdomain.com
