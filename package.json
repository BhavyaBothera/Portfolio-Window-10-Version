{
  "name": "windows-10-portfolio-os",
  "version": "6.0.0",
  "description": "Full-Stack Windows 10 Portfolio OS built with Node.js, Express, SQLite, and Vanilla Web OS Shell",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e"
  },
  "keywords": [
    "portfolio",
    "windows10",
    "web-os",
    "express",
    "sqlite",
    "full-stack"
  ],
  "author": "Bhavy",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "helmet": "^8.3.0",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
